  (gr_line (start 349 87.232) (end 349 106.432) (stroke (width 0.12) (type solid)) (layer "Dwgs.User") (tstamp 89805892-9131-4276-95d0-76ab14d21cf8))
  (gr_text "ASSEMBLY DRAWING (TOP) - QBF-X2 carrier rev A (2026-11-24)" (at 16 16) (layer "Cmts.User") (tstamp 8d2e39d7-b2fe-4ec1-a401-7081d5ffe103) (effects (font (size 2.6 2.6) (thickness 0.4)) (justify left)))
  (gr_text "All parts on the top side. Bottom = continuous GND (contacts the Cu sample-holder base)." (at 16 21) (layer "Cmts.User") (tstamp 61a670d1-9e9f-41b6-aa0f-5b8f5d818bb2) (effects (font (size 1.5 1.5) (thickness 0.225)) (justify left)))
  (gr_text "ASSEMBLY NOTES" (at 205 14.2) (layer "Cmts.User") (tstamp 188860d1-6bf1-4639-a162-cdf43c6eefa2) (effects (font (size 1.56 1.56) (thickness 0.234)) (justify left)))
  (gr_text "1  SMT reflow, top side only: SAC305 (or Sn63Pb37), no-clean low-residue flux, then clean (IPA). No bottom parts." (at 205 16.48) (layer "Cmts.User") (tstamp 00464bff-11bf-400e-8aa4-49145e57ca66) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "2  Use ONLY the BOM parts (non-magnetic): no Ni-barrier terminations, no X7R/X5R, no ferrite, no brass." (at 205 18.616) (layer "Cmts.User") (tstamp 89f33e51-376e-4050-a045-f14fdd341b47) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "3  J1-J10 SMP: reflow with the land pattern of the vendor drawing; check centre-pin coplanarity < 0.1 mm." (at 205 20.752) (layer "Cmts.User") (tstamp c9ed6351-1588-4cbe-9a78-6d78eb890ec9) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "4  J11 micro-D: hand-solder after reflow; trim tails to <= 0.3 mm below the board (or relieve the base)." (at 205 22.888) (layer "Cmts.User") (tstamp fc5e2724-8838-4715-b89e-289dcbce9d29) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "5  Board to base: dowels in DW1/DW2, then 4 x M2.5 non-magnetic (brass / Ti) screws in H1-H4, 0.25 N m." (at 205 25.024) (layer "Cmts.User") (tstamp 50032aab-9dc2-4705-aa91-194a16f30f56) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "6  Die U1 (customer supplied, after PCBA + cleaning): on the base pedestal, top flush with the PCB top" (at 205 27.16) (layer "Cmts.User") (tstamp aeca0ea2-9ed8-4dc6-9512-3331c84e2cbd) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "   (pedestal 0.957 mm above the base for 20 um varnish), GE 7031 varnish or Ag paint." (at 205 29.296) (layer "Cmts.User") (tstamp af17802d-a231-4b70-a75a-5be9f1d1a9a3) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "   Orientation: die launcher 1 at the NW corner of the north row (dot on F.Fab), ids per die_pads.json." (at 205 31.432) (layer "Cmts.User") (tstamp fa27e3da-3af4-4c27-9d8e-5321c671095e) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "7  Wire bonds: Al-1%Si 25 um wedge, 2 per signal launcher, <= 1.0 mm long, straight (pads are aligned);" (at 205 33.568) (layer "Cmts.User") (tstamp 715d5acf-a288-4bbc-90c5-2046470593d2) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "   ground bonds from the die ground plane to the exposed GND band: >= 2 between launchers + 4 per corner." (at 205 35.704) (layer "Cmts.User") (tstamp 40aaaa2c-a8d9-47da-8335-5870474e04ad) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "8  ESD: Josephson junctions - ground all SMP and J11 lines while bonding and handling." (at 205 37.84) (layer "Cmts.User") (tstamp 62928b46-5491-4f38-b936-ae388572da94) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "9  Fiducials FID1-FID3 (1.0 mm Cu, 2.0 mm mask opening). Placement origin = board lower-left corner." (at 205 39.976) (layer "Cmts.User") (tstamp af2671df-d511-4d7d-8a31-070748d9ae75) (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "BOM SUMMARY (full BOM: fab/qbfx2_carrier_bom.csv)" (at 205 45.072) (layer "Cmts.User") (tstamp 56cc71af-ef43-485b-937a-893de4a24b31) (effects (font (size 1.5 1.5) (thickness 0.225)) (justify left)))
