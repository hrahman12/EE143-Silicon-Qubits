(version 1)
# QBF-X2 carrier design rules, rev B (generated by build_carrier.py from carrier_params.py).
# Board-level minima live in qbfx2_carrier.kicad_pro (clearance 0.15, track 0.12,
# via 0.45/0.2, annular 0.125, hole-hole 0.25,
# copper-edge 0.1 for the wire-bond landing pads at the die window).
# Rule order matters: when two rules give the same constraint, the later one wins (RF rules after the DC rules).

# --- DC lines: stripline on In2 between the In1 / In3 GND planes
(rule "DC_In2_width"
  (layer "In2.Cu")
  (condition "A.NetClass == 'DC' && A.Type == 'Track'")
  (constraint track_width (min 0.15mm)))
(rule "DC_clearance"
  (condition "A.NetClass == 'DC'")
  (constraint clearance (min 0.20mm)))

# --- 50-ohm GCPW on F.Cu (readout lines RF_50; also every leg of the fast pairs RF_DIFF): w = 0.39 mm,
#     gap = 0.17 mm over 0.203 mm RO4003C (In1 = reference)
(rule "RF_GCPW_width"
  (layer "F.Cu")
  (condition "A.NetClass == 'RF_50' && (A.Type == 'Track' || A.Type == 'Arc')")
  (constraint track_width (min 0.38mm) (opt 0.39mm) (max 0.40mm)))
(rule "RF_GCPW_gap"
  (condition "(A.NetClass == 'RF_50' || A.NetClass == 'RF_DIFF') && B.NetName == 'GND'")
  (constraint clearance (min 0.17mm)))
(rule "RF_to_other_signals"
  (condition "(A.NetClass == 'RF_50' || A.NetClass == 'RF_DIFF') && B.NetName != 'GND' && A.NetName != B.NetName && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.40mm)))
(rule "RF_top_layer_only"
  (layer inner)
  (condition "A.NetClass == 'RF_50' || A.NetClass == 'RF_DIFF'")
  (constraint disallow track via))
(rule "RF_no_vias"
  (condition "(A.NetClass == 'RF_50' || A.NetClass == 'RF_DIFF') && A.Type == 'Via'")
  (constraint disallow via))

# --- fast flux lines: 8 edge-coupled GCPW differential pairs <name>_P / <name>_N (KiCad pairs them by the suffix).
#     Routed: w 0.39 / gap 0.65 (P-N) / 0.17 to GND -> Z_odd 50 ohm, loosely coupled.
#     Breakout at the die: w 0.29 / gap 0.21 (leg pitch 0.50 mm = die pad pitch).
#     Width and gap are checked per section (the two widths are the two allowed bands). Between the legs: no ground
#     pour and no vias (F.Cu keepouts "DIFF_<pair>_no_gnd_no_via"). KiCad 7 measures the coupled length on straight
#     segments only; every straight next to an arc or a pad begins with a 0.25 mm coupling stub (diffpair.py).
(rule "DIFF_intra_pair_clearance"
  (condition "A.inDiffPair('*') && AB.isCoupledDiffPair()")
  (constraint clearance (min 0.20mm)))
(rule "DIFF_routed"
  (layer "F.Cu")
  (condition "A.inDiffPair('*') && (A.Type == 'Track' || A.Type == 'Arc') && A.Width >= 0.34mm")
  (constraint track_width (min 0.38mm) (opt 0.39mm) (max 0.40mm))
  (constraint diff_pair_gap (min 0.64mm) (opt 0.65mm) (max 0.66mm))
  (constraint diff_pair_uncoupled (max 10.50mm)))
(rule "DIFF_breakout"
  (layer "F.Cu")
  (condition "A.inDiffPair('*') && (A.Type == 'Track' || A.Type == 'Arc') && A.Width < 0.34mm")
  (constraint track_width (min 0.28mm) (opt 0.29mm) (max 0.30mm))
  (constraint diff_pair_gap (min 0.20mm) (opt 0.21mm) (max 0.22mm))
  (constraint diff_pair_uncoupled (max 1.20mm)))

# --- intra-pair skew |L_P - L_N| <= 0.10 mm (~0.5 ps). KiCad 7 defines skew as the net length minus the
#     average length of the nets matched by the rule, so for two nets max 0.050 mm here means
#     |L_P - L_N| <= 0.10 mm. One rule per pair, so each pair is its own group.
(rule "TRAP_A0_intra_pair_skew"
  (condition "A.inDiffPair('TRAP_A0')")
  (constraint skew (max 0.050mm)))
(rule "ACC_A0_intra_pair_skew"
  (condition "A.inDiffPair('ACC_A0')")
  (constraint skew (max 0.050mm)))
(rule "ACC_A1_intra_pair_skew"
  (condition "A.inDiffPair('ACC_A1')")
  (constraint skew (max 0.050mm)))
(rule "TRAP_A1_intra_pair_skew"
  (condition "A.inDiffPair('TRAP_A1')")
  (constraint skew (max 0.050mm)))
(rule "TRAP_B1_intra_pair_skew"
  (condition "A.inDiffPair('TRAP_B1')")
  (constraint skew (max 0.050mm)))
(rule "ACC_B1_intra_pair_skew"
  (condition "A.inDiffPair('ACC_B1')")
  (constraint skew (max 0.050mm)))
(rule "ACC_B0_intra_pair_skew"
  (condition "A.inDiffPair('ACC_B0')")
  (constraint skew (max 0.050mm)))
(rule "TRAP_B0_intra_pair_skew"
  (condition "A.inDiffPair('TRAP_B0')")
  (constraint skew (max 0.050mm)))

# --- A/B matching: every TRAP leg within +/-0.10 mm of the TRAP nominal and every ACC leg within
#     +/-0.10 mm of the ACC nominal, so corresponding A and B pairs agree within 0.20 mm
#     (a length rule, because each net can belong to only one skew rule)
(rule "TRAP_A_vs_B_length"
  (condition "A.inDiffPair('TRAP_*')")
  (constraint length (min 32.245mm) (max 32.445mm)))
(rule "ACC_A_vs_B_length"
  (condition "A.inDiffPair('ACC_*')")
  (constraint length (min 24.529mm) (max 24.729mm)))

# --- vias (single through-via process, aspect ratio <= 7.5)
(rule "via_geometry"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.45mm))
  (constraint hole_size (min 0.20mm))
  (constraint annular_width (min 0.125mm)))

# --- edges: only the wire-bond landing pads / bond ring may approach the die window
(rule "tracks_vias_from_edges"
  (condition "A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via'")
  (constraint edge_clearance (min 0.30mm)))
# inner layers keep 0.30 mm from the die window through the keepout area "window_pullback_inner"
