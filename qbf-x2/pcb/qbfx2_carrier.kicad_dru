(version 1)
# QBF-X2 carrier design rules (generated by build_carrier.py from carrier_params.py).
# Board-level minima live in qbfx2_carrier.kicad_pro (clearance 0.15, track 0.12,
# via 0.45/0.2, annular 0.125, hole-hole 0.25,
# copper-edge 0.1 for the wire-bond landing pads at the die window).

# --- 50-ohm GCPW on F.Cu: w = 0.4 mm, gap = 0.15 mm over 0.203 mm RO4003C (In1 = reference)
(rule "RF_GCPW_width"
  (layer "F.Cu")
  (condition "A.NetClass == 'RF_50' && (A.Type == 'Track' || A.Type == 'Arc')")
  (constraint track_width (min 0.39mm) (opt 0.40mm) (max 0.41mm)))
(rule "RF_GCPW_gap"
  (condition "A.NetClass == 'RF_50' && B.NetName == 'GND'")
  (constraint clearance (min 0.15mm)))
(rule "RF_to_other_signals"
  (condition "A.NetClass == 'RF_50' && B.NetName != 'GND' && A.NetName != B.NetName")
  (constraint clearance (min 0.40mm)))
(rule "RF_top_layer_only"
  (layer inner)
  (condition "A.NetClass == 'RF_50'")
  (constraint disallow track via))
(rule "RF_no_vias"
  (condition "A.NetClass == 'RF_50' && A.Type == 'Via'")
  (constraint disallow via))

# --- length matching (A line vs B partner arrive within 0.2 mm ~ 1.3 ps)
(rule "TRAP_A_vs_TRAP_B_skew"
  (condition "A.NetName == 'TRAP_A0' || A.NetName == 'TRAP_A1' || A.NetName == 'TRAP_B1' || A.NetName == 'TRAP_B0'")
  (constraint skew (max 0.20mm)))
(rule "ACC_A_vs_ACC_B_skew"
  (condition "A.NetName == 'ACC_A0' || A.NetName == 'ACC_A1' || A.NetName == 'ACC_B1' || A.NetName == 'ACC_B0'")
  (constraint skew (max 0.20mm)))

# --- DC lines: stripline on In2 between the In1 / In3 GND planes
(rule "DC_In2_width"
  (layer "In2.Cu")
  (condition "A.NetClass == 'DC' && A.Type == 'Track'")
  (constraint track_width (min 0.15mm)))
(rule "DC_clearance"
  (condition "A.NetClass == 'DC'")
  (constraint clearance (min 0.20mm)))

# --- vias (single through-via process, aspect ratio <= 7.5)
(rule "via_geometry"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.45mm))
  (constraint hole_size (min 0.20mm))
  (constraint annular_width (min 0.125mm)))

# --- edges: only the wire-bond landing pads / bond ring may approach the die window
(rule "tracks_vias_from_edges"
  (condition "A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via'")
  (constraint edge_clearance (min 0.30mm)))
(rule "inner_layers_from_edges"
  (layer inner)
  (constraint edge_clearance (min 0.30mm)))
